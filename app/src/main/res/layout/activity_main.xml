<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/status_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/system_status"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/privilege_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/privilege_label" />

    <TextView
        android:id="@+id/lockdown_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lockdown_label" />

    <TextView
        android:id="@+id/message_log"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:background="#EEEEEE"
        android:padding="8dp"
        android:text="@string/logs_placeholder" />

    <Button
        android:id="@+id/btn_provision"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/btn_provision" />

    <Button
        android:id="@+id/btn_enable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_enable" />

    <Button
        android:id="@+id/btn_disable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_disable" />

    <Button
        android:id="@+id/btn_tamper_on"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_tamper_on" />

    <Button
        android:id="@+id/btn_tamper_off"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_tamper_off" />

</LinearLayout>